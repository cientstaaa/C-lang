#include <stdio.h>

int main() {

    int notas[6]     = {200, 100, 50, 20, 10, 5};
    int estoque[6]   = {5, 5, 5, 5, 5, 5};   // quantidade de cada nota no caixa
    int entregues[6] = {0, 0, 0, 0, 0, 0};   // quantas notas serao entregues
    int restante = valor;
    int valor;

    printf("Digite o valor do saque: ");
    scanf("%d", &valor);

    if (valor <= 0 || valor % 5 != 0) {
        printf("Valor invalido para saque.\n");
        return 0;
    }

    for (int i = 0; i < 6; i++) {
        int disponivelParaSaque = estoque[i] - 1; // preserva 1 nota

        while (restante >= notas[i] && disponivelParaSaque > 0) {
            restante -= notas[i];
            entregues[i]++;
            disponivelParaSaque--;
        }
    }

    if (restante > 0) {
        printf("Nao e possivel realizar o saque pela reserva minima de notas.\n");
        return 0;
    }

    printf("Saque realizado com sucesso!\n");
    int totalNotas = 0;

    for (int i = 0; i < 6; i++) {
        if (entregues[i] > 0) {
            printf("%d nota(s) de R$ %d\n", entregues[i], notas[i]);
            totalNotas += entregues[i];
        }
    }

    printf("Total de notas entregues: %d\n", totalNotas);

}
