#include <stdio.h>

#define ALUNOS 10

float somaNotas(float notas[], int i, int qtd);
float calcularMediaTurma(float notas[], int qtd);
float encontrarMaiorNota(float notas[], int i, int qtd);
int contarAprovados(float notas[], int i, int qtd);
void exibirResultados(float media, float maior, int aprovados);

int main() {
    float notas[ALUNOS];

    for (int i = 0; i < ALUNOS; i++){
        printf("Digite a nota do aluno %d: ", i + 1);
        scanf("%f", &notas[i]);
    }

    float media = calcularMediaTurma(notas, ALUNOS);
    float maior = encontrarMaiorNota(notas, 0, ALUNOS);
    int aprovados = contarAprovados(notas, 0, ALUNOS);

    exibirResultados(media, maior, aprovados);
}

float somaNotas(float notas[], int i, int qtd){
    if (i == qtd) {
        return 0;
    }
    return notas[i] + somaNotas(notas, i + 1, qtd);
}

float calcularMediaTurma(float notas[], int qtd){
    return somaNotas(notas, 0, qtd) / qtd;
}

float encontrarMaiorNota(float notas[], int i, int qtd){
    if (i == qtd - 1){
        return notas[i];
    }

    float maiorDoResto = encontrarMaiorNota(notas, i + 1, qtd);

    if (notas[i] > maiorDoResto){
        return notas[i];
    }
    return maiorDoResto;
}

int contarAprovados(float notas[], int i, int qtd){
    if (i == qtd){
        return 0;
    }
    if (notas[i] >= 7.0){
        return 1 + contarAprovados(notas, i + 1, qtd);
    }
    return contarAprovados(notas, i + 1, qtd);
}

void exibirResultados(float media, float maior, int aprovados){
    printf("\nMedia da turma: %.2f\n", media);
    printf("Maior nota: %.2f\n", maior);
    printf("Alunos aprovados: %d\n", aprovados);
}
