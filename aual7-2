#include <stdio.h>

int calcularDobro(int num);

int main()
{
    int num, result;
    
    printf("Digite um numero e veja seu dobro: \n");
    scanf("%d", &num);
    
    result = calcularDobro(num);
    printf("o dobro de %d eh: %d", num, result);
}

int calcularDobro(int num) {
    return num * 2;
}
